{
  "manifest_version": 3,
  "name": "UPipe",
  "short_name": "UPipe",
  "version": "1.0.0",
  "description": "NewPipe for the web. Browse, play audio and download from YouTube, SoundCloud, Bandcamp, PeerTube and media.ccc.de. No account, no tracking.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "UPipe",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "options_ui": {
    "page": "app/options.html",
    "open_in_tab": true
  },
  "omnibox": {
    "keyword": "up"
  },
  "commands": {
    "open-upipe": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Open UPipe"
    },
    "open-player": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open the UPipe audio player"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://soundcloud.com/*",
    "https://*.soundcloud.com/*",
    "https://*.sndcdn.com/*",
    "https://bandcamp.com/*",
    "https://*.bandcamp.com/*",
    "https://*.bcbits.com/*",
    "https://api.media.ccc.de/*",
    "https://sepiasearch.org/*",
    "https://piped-instances.kavin.rocks/*",
    "https://api.invidious.io/*",
    "https://returnyoutubedislikeapi.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://rss.applemarketingtools.com/*",
    "https://hacker-news.firebaseio.com/*",
    "https://api.coingecko.com/*",
    "https://get.geojs.io/*",
    "https://suggestqueries-clients6.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "upipe@vitalsoft",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}